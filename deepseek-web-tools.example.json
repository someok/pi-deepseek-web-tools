{
	"enabled": true,
	"apiKey": "sk-your-deepseek-api-key",
	"baseUrl": "https://api.deepseek.com",
	"exposure": {
		"search": "codemode",
		"fetch": "direct"
	},
	"search": {
		"timeoutMs": 30000,
		"count": 10,
		"needContent": false
	},
	"fetch": {
		"timeoutMs": 90000
	},
	"github": {
		"enabled": true,
		"prIssue": true,
		"maxRepoSizeMB": 350,
		"cloneTimeoutSeconds": 30,
		"clonePath": "~/pi-github-repos"
	}
}
