{
	"name": "@someok/pi-deepseek-web-tools",
	"version": "0.3.0",
	"description": "pi 扩展：DeepSeek 网页搜索（ds_search）与网页抓取（ds_fetch），GitHub 链接自动 clone 仓库并渲染 PR/Issue",
	"type": "module",
	"license": "MIT",
	"author": "JX Wang <wjianxu@gmail.com>",
	"homepage": "https://github.com/someok/pi-deepseek-web-tools#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/someok/pi-deepseek-web-tools.git"
	},
	"bugs": {
		"url": "https://github.com/someok/pi-deepseek-web-tools/issues"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"keywords": [
		"pi-package",
		"pi-extension",
		"deepseek",
		"search",
		"fetch",
		"github"
	],
	"files": [
		"src",
		"README.md",
		"README.zh-CN.md",
		"LICENSE",
		"deepseek-web-tools.example.json"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test": "vitest --run",
		"typecheck": "tsc --noEmit",
		"check": "npm run typecheck && npm test",
		"release": "npm publish",
		"prepublishOnly": "npm run check"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "1.3.0",
		"@earendil-works/pi-tui": "1.3.0",
		"@types/node": "^24.0.0",
		"typebox": "1.3.27",
		"typescript": "^5.9.0",
		"vitest": "^4.1.0"
	}
}
